# Server
HOST=0.0.0.0
PORT=8005
LOG_DIR=shared_data/logs

# Authentication (choose one)
# Shared bearer token
# AUTH_BEARER_TOKEN=secret
# or legacy name
# AUTH_TOKEN=secret

# Basic auth
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASS=s3cr3t

# Paths that do not require auth (comma-separated prefixes)
AUTH_EXEMPT_PATHS=/health,/metrics

# MCP handshake: allow specific JSON-RPC methods without auth (comma-separated)
# Default enables basic bootstrap while still requiring auth for tool execution
# AUTH_EXEMPT_METHODS=initialize,tools/list,ping,resources/list,prompts/list

# Some clients open a GET /mcp stream; enable public access explicitly if needed
# AUTH_PUBLIC_GET_MCP=false